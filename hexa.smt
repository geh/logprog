(declare-const h0 Int)
(declare-const h1 Int)
(declare-const h2 Int)
(declare-const h3 Int)
(declare-const h4 Int)
(declare-const h5 Int)
(declare-const h6 Int)
(declare-const h7 Int)
(declare-const h8 Int)
(declare-const sum Int)

(assert (> h0 0))
(assert (> h1 0))
(assert (> h2 0))
(assert (> h3 0))
(assert (> h4 0))
(assert (> h5 0))
(assert (> h6 0))
(assert (> h7 0))
(assert (> h8 0))
(assert (distinct h0 h1 h2 h3 h4 h5 h6 h7 h8))

(assert (= (+ h0 h2 h4 h6 h8) (+ h1 h3 h5 h7)))
(assert (= (+ h0 h1 h2)
           (+ h3 h4 h5)
           (+ h6 h7 h8)))
(assert (= (+ h0 h1 h2 h3 h4 h5 h6 h7 h8)
            sum))
(assert (<= sum 50))
(check-sat)
(get-model)
