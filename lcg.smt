(set-option :pp.bv-literals false)
(declare-const state1 (_ BitVec 32))
(declare-const state2 (_ BitVec 32))
(declare-const state3 (_ BitVec 32))
(declare-const state4 (_ BitVec 32))
(declare-const state5 (_ BitVec 32))
(declare-const state6 (_ BitVec 32))
(declare-const state7 (_ BitVec 32))
(declare-const state8 (_ BitVec 32))
(declare-const state9 (_ BitVec 32))
(declare-const state10 (_ BitVec 32))
(declare-const output_prev (_ BitVec 32))
(declare-const output_next (_ BitVec 32))

(assert (= state2 (bvadd (bvmul state1 (_ bv214013 32))  (_ bv2531011 32))))
(assert (= state3 (bvadd (bvmul state2 (_ bv214013 32))  (_ bv2531011 32))))
(assert (= state4 (bvadd (bvmul state3 (_ bv214013 32))  (_ bv2531011 32))))
(assert (= state5 (bvadd (bvmul state4 (_ bv214013 32))  (_ bv2531011 32))))
(assert (= state6 (bvadd (bvmul state5 (_ bv214013 32))  (_ bv2531011 32))))
(assert (= state7 (bvadd (bvmul state6 (_ bv214013 32))  (_ bv2531011 32))))
(assert (= state8 (bvadd (bvmul state7 (_ bv214013 32))  (_ bv2531011 32))))
(assert (= state9 (bvadd (bvmul state8 (_ bv214013 32))  (_ bv2531011 32))))
(assert (= state10 (bvadd (bvmul state9 (_ bv214013 32))  (_ bv2531011 32))))

(assert (= (bvurem (bvand (bvlshr state2 (_ bv16 32)) #x00007FFF) (_ bv100 32))
           (_ bv29 32)))
(assert (= (bvurem (bvand (bvlshr state3 (_ bv16 32)) #x00007FFF) (_ bv100 32))
           (_ bv74 32)))
(assert (= (bvurem (bvand (bvlshr state4 (_ bv16 32)) #x00007FFF) (_ bv100 32))
           (_ bv95 32)))
(assert (= (bvurem (bvand (bvlshr state5 (_ bv16 32)) #x00007FFF) (_ bv100 32))
           (_ bv98 32)))
(assert (= (bvurem (bvand (bvlshr state6 (_ bv16 32)) #x00007FFF) (_ bv100 32))
           (_ bv40 32)))
(assert (= (bvurem (bvand (bvlshr state7 (_ bv16 32)) #x00007FFF) (_ bv100 32))
           (_ bv23 32)))
(assert (= (bvurem (bvand (bvlshr state8 (_ bv16 32)) #x00007FFF) (_ bv100 32))
           (_ bv58 32)))
(assert (= (bvurem (bvand (bvlshr state9 (_ bv16 32)) #x00007FFF) (_ bv100 32))
           (_ bv61 32)))

(assert (= (bvurem (bvand (bvlshr state1 (_ bv16 32)) #x00007FFF) (_ bv100 32))
           output_prev))
(assert (= (bvurem (bvand (bvlshr state10 (_ bv16 32)) #x00007FFF) (_ bv100 32))
           output_next))
; comment
(check-sat)
(get-model)

